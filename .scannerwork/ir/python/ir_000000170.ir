ìHâ"echo "Mounting bastion disk..."\nBLOOP=$(losetup -f --show /bastion/disk.img)\nBLOOP_BASE=$(basename $BLOOP)\nkpartx -av $BLOOP\nsleep 1\nBPART=/dev/mapper/${BLOOP_BASE}p3; [ -e $BPART ] || BPART=/dev/mapper/${BLOOP_BASE}p1\nmkdir -p /mnt/bastion\nif ! mount $BPART /mnt/bastion 2>/dev/null && ! mount -o nouuid $BPART /mnt/bastion 2>/dev/null; then\n  xfs_repair -L $BPART >/dev/null 2>&1 && echo 'Repaired XFS log on bastion disk'\n  mount $BPART /mnt/bastion 2>/dev/null || mount -o nouuid $BPART /mnt/bastion\nfi\nKC_SRC="/etc/kubernetes/static-pod-resources/kube-apiserver-certs/secrets/node-kubeconfigs/lb-ext.kubeconfig"\nif [ -f "$KC_SRC" ]; then\n  KC_DIR="/mnt/bastion/home/cloud-user/ocp-install/auth"\n  mkdir -p "$KC_DIR"\n"str
