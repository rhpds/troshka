FROM registry.access.redhat.com/ubi9/python-311:latest
# rebuild 2026-08-18 — troshkad bundled for dedicated update-host

WORKDIR /opt/app-root/src

# agnosticv CLI — the workloads subsystem shells out to it to list/merge AgnosticV catalog items.
ARG AGNOSTICV_VERSION=1.0.0
RUN curl -fsSL -o /opt/app-root/bin/agnosticv \
      "https://github.com/redhat-cop/agnosticv/releases/download/v${AGNOSTICV_VERSION}/agnosticv_linux_amd64" \
    && chmod +x /opt/app-root/bin/agnosticv

COPY src/backend/requirements.txt .
# libvirt-python needs system headers not available in container — exclude it
RUN grep -v -e '^libvirt-python' -e '^-e git+' requirements.txt > requirements-container.txt && \
    pip install --no-cache-dir -r requirements-container.txt

COPY src/backend/ .
# The backend imports the shared troshka_serial package (serial/headless VM exec)
# at deploy time from app/services/headless.py, kubevirt_serial.py, kubevirt.py.
# Those add sys.path parents[4] / ../../.. == /opt/app-root in-image, so ship the
# package there. Without this, any serial/headless deploy path (e.g. an OCP
# quickstart on a KubeVirt dedicated CI) fails with "No module named 'troshka_serial'".
COPY src/troshka_serial/ /opt/app-root/troshka_serial/
COPY src/troshkad/troshkad.py /opt/app-root/troshkad/troshkad.py
COPY src/troshka-vncd/troshka-vncd.py /opt/app-root/troshka-vncd/troshka-vncd.py
COPY src/operator/crds/ /opt/app-root/operator/crds/
COPY src/operator/deploy/ /opt/app-root/operator/deploy/

EXPOSE 8200

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8200", "--proxy-headers", "--forwarded-allow-ips", "*", "--loop", "uvloop", "--http", "httptools"]
