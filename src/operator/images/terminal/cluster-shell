#!/bin/bash
# Interactive shell for the showroom OpenShift Cluster Terminal. oc is baked into
# the image; the merged kubeconfig for every deployed cluster is injected onto the
# shared disk at /showroom/kube/config (root-owned 0644 — readable, not writable).
#
# We prefer to drop to the unprivileged uid-1000 lab user via setpriv. That works
# on troshkad (podman: root + CAP_SETUID). Under KubeVirt's restricted SCC the
# container runs as root but WITHOUT CAP_SETUID, so setpriv fails ("setresuid
# failed: Operation not permitted", exit 127). Probe setpriv up front and, if it
# can't drop, fall back to a shell as the current uid.
export PATH=/usr/local/bin:/usr/bin:/bin

# Wait (bounded) for the cluster to finish BUILDING before dropping to the prompt.
# While a cluster is installing (fresh install) or being recert'd (pattern deploy)
# the backend has not yet injected /showroom/kube/config, so `oc` would fail with a
# bare "Missing or incomplete configuration info" and no explanation. Show a
# friendly banner and wait for the kubeconfig to appear so `oc` works the moment we
# hand over the prompt. The user can press Ctrl-C to skip straight to a shell; a
# bounded 45-minute timeout guarantees we never hang forever (comfortably outlasts
# a slow install; a pattern recert clears in minutes). When the kubeconfig is
# already present (cluster up, or a browser reconnect after it came up) this returns
# immediately and prints nothing. Keys off the kubeconfig file, so it is identical
# for fresh-install and pattern-deployed clusters.
_wait_for_cluster_ready() {
    local kc=/showroom/kube/config i max=540 _skip=""   # 540 * 5s = 45 min
    [ -f "$kc" ] && return 0
    echo
    echo "  ⏳  Your OpenShift cluster is still being built."
    echo "      Waiting for it to come up — press Ctrl-C to skip to a shell."
    echo "      ('oc' starts working automatically once the cluster is ready.)"
    printf '      '
    # Ctrl-C sets a flag and breaks the wait instead of terminating the terminal;
    # `sleep & wait` keeps the SIGINT responsive (a bare sleep would swallow it).
    trap '_skip=1' INT
    for i in $(seq 1 "$max"); do
        [ -f "$kc" ] && break
        [ -n "$_skip" ] && break
        printf '.'
        sleep 5 & wait $! 2>/dev/null
    done
    trap - INT
    echo
    if [ -f "$kc" ]; then
        echo "  ✅  Cluster ready!"
    elif [ -n "$_skip" ]; then
        echo "  Skipping — dropping to a shell. 'oc' will work once the cluster is"
        echo "  ready; just retry your command (no need to reconnect)."
    else
        echo "  NOTE: cluster still not ready after 45m — dropping to a shell."
        echo "  'oc' will work once it comes up; just retry your command."
    fi
    echo
}
_wait_for_cluster_ready

# Wait (bounded) for the cluster API to answer before dropping to the prompt, so a
# user who opens the terminal during the post-install VIP-settling window doesn't
# hit "connection refused". Reads the API server straight from the injected
# kubeconfig, so it targets the right endpoint for every topology (SNO: the node's
# own IP; compact/standard: the api VIP). Only the OpenShift Cluster Terminal runs
# this script (RHEL/other terminals use a plain ssh shell), so nothing else waits.
# Never blocks forever — it drops to the shell after the window regardless.
_wait_for_cluster_api() {
    local kc=/showroom/kube/config server host port i
    [ -f "$kc" ] || return 0
    server=$(awk '/[[:space:]]server:/{print $2; exit}' "$kc" 2>/dev/null)
    [ -n "$server" ] || return 0
    host=${server#*://}; host=${host%%/*}; port=${host##*:}; host=${host%%:*}
    [ "$port" = "$host" ] && port=6443
    [ -n "$host" ] || return 0
    for i in $(seq 1 30); do
        timeout 3 bash -c "</dev/tcp/$host/$port" 2>/dev/null && return 0
        [ "$i" = 1 ] && echo "Waiting for the OpenShift API ($host:$port) to become available..."
        sleep 3
    done
    echo "NOTE: OpenShift API ($host:$port) not reachable yet — dropping to the shell; retry 'oc get nodes' shortly."
}
_wait_for_cluster_api

_can_drop=""
if command -v setpriv >/dev/null 2>&1 \
    && setpriv --reuid=1000 --regid=1000 --init-groups true >/dev/null 2>&1; then
    _can_drop=1
fi

if [ -n "$_can_drop" ]; then
    # Privilege drop available: prep uid-1000's home + kubeconfig, then drop.
    export HOME=/home/labuser
    # Copy target is a SINGLE writable file; KUBECONFIG is a colon-LIST that also
    # includes the live /showroom/kube/config (0644, readable by uid-1000) as a
    # fallback: the copy is made ONCE at terminal start, so a terminal opened DURING
    # the install — before the kubeconfig is injected — would otherwise never see
    # it. With it in KUBECONFIG, oc reads the injected file as soon as it appears,
    # no reconnect needed; writes still go to the copy (first entry).
    KC_COPY="$HOME/.kube/config"
    export KUBECONFIG="$KC_COPY:/showroom/kube/config"
    if [ -f /showroom/kube/config ]; then
        install -d -o 1000 -g 1000 -m 0700 "$HOME/.kube"
        install -o 1000 -g 1000 -m 0600 /showroom/kube/config "$KC_COPY"
    fi
    cd "$HOME" 2>/dev/null || cd /tmp || cd /
    # Launch inside tmux (attach-or-create session "main") so a browser refresh /
    # iframe reload / network blip reattaches to the SAME session and running
    # commands (e.g. `watch oc get nodes`) survive. Fall back to bash if tmux is
    # unavailable.
    if command -v tmux >/dev/null 2>&1; then
        exec setpriv --reuid=1000 --regid=1000 --init-groups tmux new-session -A -s main
    fi
    exec setpriv --reuid=1000 --regid=1000 --init-groups /bin/bash
fi

# Fallback (KubeVirt restricted SCC): can't drop privileges — run as the current
# uid. Use a writable HOME and a kubeconfig copy the current uid can read.
if [ -z "$HOME" ] || [ ! -w "$HOME" ]; then
    export HOME=/tmp
fi
# Copy target is a SINGLE writable file; KUBECONFIG is a colon-LIST with the live
# /showroom/kube/config as a fallback so a terminal opened before the kubeconfig is
# injected still picks it up once it appears (see the drop path).
KC_COPY="$HOME/.kube/config"
export KUBECONFIG="$KC_COPY:/showroom/kube/config"
if [ -f /showroom/kube/config ]; then
    mkdir -p "$HOME/.kube"
    cp /showroom/kube/config "$KC_COPY" 2>/dev/null && chmod 0600 "$KC_COPY" 2>/dev/null
fi
cd "$HOME" 2>/dev/null || cd /tmp || cd /
# Session persistence via tmux (see the drop path above); bash if tmux is absent.
if command -v tmux >/dev/null 2>&1; then
    exec tmux new-session -A -s main
fi
exec /bin/bash
