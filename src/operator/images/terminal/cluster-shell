#!/bin/bash
# Interactive shell for the showroom OpenShift Cluster Terminal. oc is baked into
# the image; the merged kubeconfig for every deployed cluster is injected onto the
# shared disk at /showroom/kube/config (root-owned 0644 — readable, not writable).
#
# We prefer to drop to the unprivileged uid-1000 lab user via setpriv. That works
# on troshkad (podman: root + CAP_SETUID). Under KubeVirt's restricted SCC the
# container runs as root but WITHOUT CAP_SETUID, so setpriv fails ("setresuid
# failed: Operation not permitted", exit 127). Probe setpriv up front and, if it
# can't drop, fall back to a shell as the current uid.
export PATH=/usr/local/bin:/usr/bin:/bin

# Wait (bounded) for the cluster API to answer before dropping to the prompt, so a
# user who opens the terminal during the post-install VIP-settling window doesn't
# hit "connection refused". Reads the API server straight from the injected
# kubeconfig, so it targets the right endpoint for every topology (SNO: the node's
# own IP; compact/standard: the api VIP). Only the OpenShift Cluster Terminal runs
# this script (RHEL/other terminals use a plain ssh shell), so nothing else waits.
# Never blocks forever — it drops to the shell after the window regardless.
_wait_for_cluster_api() {
    local kc=/showroom/kube/config server host port i
    [ -f "$kc" ] || return 0
    server=$(awk '/[[:space:]]server:/{print $2; exit}' "$kc" 2>/dev/null)
    [ -n "$server" ] || return 0
    host=${server#*://}; host=${host%%/*}; port=${host##*:}; host=${host%%:*}
    [ "$port" = "$host" ] && port=6443
    [ -n "$host" ] || return 0
    for i in $(seq 1 30); do
        timeout 3 bash -c "</dev/tcp/$host/$port" 2>/dev/null && return 0
        [ "$i" = 1 ] && echo "Waiting for the OpenShift API ($host:$port) to become available..."
        sleep 3
    done
    echo "NOTE: OpenShift API ($host:$port) not reachable yet — dropping to the shell; retry 'oc get nodes' shortly."
}
_wait_for_cluster_api

_can_drop=""
if command -v setpriv >/dev/null 2>&1 \
    && setpriv --reuid=1000 --regid=1000 --init-groups true >/dev/null 2>&1; then
    _can_drop=1
fi

if [ -n "$_can_drop" ]; then
    # Privilege drop available: prep uid-1000's home + kubeconfig, then drop.
    export HOME=/home/labuser
    # Include the live /showroom/kube/config as a fallback (it's 0644, readable by
    # uid-1000): the writable copy below is made ONCE at terminal start, so a
    # terminal opened DURING the install — before the kubeconfig is injected — would
    # otherwise never see it. With it in KUBECONFIG, oc reads the injected file as
    # soon as it appears, no reconnect needed; writes still go to the copy (first).
    export KUBECONFIG="$HOME/.kube/config:/showroom/kube/config"
    if [ -f /showroom/kube/config ]; then
        install -d -o 1000 -g 1000 -m 0700 "$HOME/.kube"
        install -o 1000 -g 1000 -m 0600 /showroom/kube/config "$KUBECONFIG"
    fi
    cd "$HOME" 2>/dev/null || cd /tmp
    exec setpriv --reuid=1000 --regid=1000 --init-groups /bin/bash
fi

# Fallback (KubeVirt restricted SCC): can't drop privileges — run as the current
# uid. Use a writable HOME and a kubeconfig copy the current uid can read.
if [ -z "$HOME" ] || [ ! -w "$HOME" ]; then
    export HOME=/tmp
fi
# Live /showroom/kube/config as a fallback so a terminal opened before the
# kubeconfig is injected still picks it up once it appears (see the drop path).
export KUBECONFIG="$HOME/.kube/config:/showroom/kube/config"
if [ -f /showroom/kube/config ]; then
    mkdir -p "$HOME/.kube"
    cp /showroom/kube/config "$KUBECONFIG" 2>/dev/null && chmod 0600 "$KUBECONFIG" 2>/dev/null
fi
cd "$HOME" 2>/dev/null || cd /tmp
exec /bin/bash
